{
    "name": "otago/shared-policy-library",
    "description": "What the Policy Library shares between the marketing website and the intranet: preparing a policy's text for the page, and the Section filter's rules.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Jeffrey Dick",
            "email": "jeffrey.dick@op.ac.nz"
        }
    ],
    "require": {
        "php": ">=8.3",
        "silverstripe/framework": "^6"
    },
    "autoload": {
        "psr-4": {
            "Otago\\SharedPolicyLibrary\\": "src/",
            "Otago\\SharedPolicyLibrary\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "expose": [
            "client/javascript"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
